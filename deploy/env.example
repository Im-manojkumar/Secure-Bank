# Copy to .env (never commit it) and replace each value.
# Make random values with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
# Set once before the first import; changing it later breaks the link between a card's old and new payments.
CARD_ID_KEY=replace-with-another-long-random-value
# Your domain, used by Caddy for the HTTPS certificate. Leave as localhost for a local demo.
SITE_ADDRESS=localhost
